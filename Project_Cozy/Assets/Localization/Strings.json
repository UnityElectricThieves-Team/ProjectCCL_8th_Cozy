  "UISettings.tooltip.admin_mode": { "ko-KR": "게임에 관리자 권한을 부여해요. 다른 작업 중에도 마우스·키보드 입력이 누적돼요.", "en-US": "Gives the game administrator access. Mouse and keyboard input keeps adding up even while you're doing something else.", "ja-JP": "ゲームに管理者権限を付与します。ほかの作業中もマウス・キーボードの入力が加算されます。", "zh-Hans": "授予游戏管理员权限。即使在进行其他操作时，鼠标和键盘输入也会持续累积。", "zh-Hant": "授予遊戲管理員權限。即使在進行其他操作時，滑鼠和鍵盤輸入也會持續累積。" },
  "UISettings.tooltip.auto_start": { "ko-KR": "PC가 시작되면 자동으로 게임을 실행해요.", "en-US": "Launches the game automatically when your PC starts.", "ja-JP": "PCの起動時にゲームを自動で起動します。", "zh-Hans": "电脑启动时自动运行游戏。", "zh-Hant": "電腦啟動時自動執行遊戲。" },
  "UISettings.tooltip.girl_transform_ban": { "ko-KR": "고양이들이 소녀로 변신하지 못하도록 막아요.", "en-US": "Stops the cats from transforming into girls.", "ja-JP": "猫たちが少女に変身しないようにします。", "zh-Hans": "阻止猫咪们变身为少女。", "zh-Hant": "阻止貓咪們變身為少女。" },
  "UISettings.tooltip.cloud_count": { "ko-KR": "구름에 모인 기운 수치를 표시할 방법을 변경해요.", "en-US": "Changes how the energy gathered in the cloud is shown.", "ja-JP": "雲に集まった気の数値の表示方法を変更します。", "zh-Hans": "更改云朵中聚集的能量数值的显示方式。", "zh-Hant": "變更雲朵中聚集的能量數值的顯示方式。" },
  "UISettings.tooltip.affinity_count": { "ko-KR": "캐릭터 친밀도를 표시할 방법을 변경해요.", "en-US": "Changes how character affinity is shown.", "ja-JP": "キャラクターの親密度の表示方法を変更します。", "zh-Hans": "更改角色亲密度的显示方式。", "zh-Hant": "變更角色親密度的顯示方式。" },
