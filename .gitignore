# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
# Recommended: add any editor/OS/tool-specific ignore rules from the Global/ templates as needed.
# See: https://github.com/github/gitignore/tree/main/Global
#
.utmp/
/Project_Cozy/[Ll]ibrary/
/Project_Cozy/[Tt]emp/
/Project_Cozy/[Oo]bj/
/Project_Cozy/[Bb]uild/
/Project_Cozy/[Bb]uilds/
/Project_Cozy/[Ll]ogs/
/Project_Cozy/[Uu]ser[Ss]ettings/
*.log

# By default unity supports Blender asset imports, *.blend1 blender files do not need to be commited to version control.
*.blend1
*.blend1.meta

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/Project_Cozy/[Mm]emoryCaptures/

# Recordings can get excessive in size
/Project_Cozy/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /Project_Cozy/[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/Project_Cozy/[Aa]ssets/Plugins/Editor/JetBrains*
# Jetbrains Rider personal-layer settings
*.DotSettings.user

# Visual Studio cache directory
.vs/

# VSCode workspace settings (개인 IDE 설정 — 팀 표준 필요해지면 부분 추적으로 전환)
.vscode/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Mono auto generated files
mono_crash.*

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# TestRunner generated files
InitTestScene*.unity*

# Addressables default ignores, before user customizations
/Project_Cozy/ServerData
/Project_Cozy/[Aa]ssets/StreamingAssets/aa*
/Project_Cozy/[Aa]ssets/AddressableAssetsData/link.xml*
/Project_Cozy/[Aa]ssets/Addressables_Temp*
# By default, Addressables content builds will generate addressables_content_state.bin
# files in platform-specific subfolders, for example:
# /Project_Cozy/Assets/AddressableAssetsData/OSX/addressables_content_state.bin
/Project_Cozy/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting auto-generated files
/Project_Cozy/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/Project_Cozy/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/Project_Cozy/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/Project_Cozy/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Auto-generated scenes by play mode tests
/Project_Cozy/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# Auto-generated cache in Assets folder
/Project_Cozy/[Aa]ssets/[Ss]ceneDependencyCache*

# OS-specific noise
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# Claude Code 작업물 (팀 합의 후 재검토 — Docs/TODO.md 참조)

CLAUDE.local.md